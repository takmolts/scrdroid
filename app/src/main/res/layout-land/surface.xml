<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/background_dark">

    <LinearLayout
        android:id="@+id/container1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="1">

        <SurfaceView
            android:id="@+id/decoder_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Floating menu toggle button (bottom-right) -->
    <Button
        android:id="@+id/fab_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_selector"
        android:text="@string/fab_menu_icon"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:alpha="0.6" />

    <!-- Floating control panel (icon tiles, hidden by default) -->
    <LinearLayout
        android:id="@+id/floating_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="68dp"
        android:background="#E02A2C36"
        android:orientation="vertical"
        android:padding="5dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/fab_screen_off"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/fab_tile_selector"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/fab_screen_off"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <Button
                android:id="@+id/fab_mute"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/fab_tile_selector"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/fab_mute_off"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <Button
                android:id="@+id/fab_orientation"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/fab_tile_selector"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/fab_orientation_auto"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/fab_back"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/fab_tile_selector"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/fab_back"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <Button
                android:id="@+id/fab_home"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/fab_tile_selector"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/fab_home"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <Button
                android:id="@+id/fab_appswitch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="3dp"
                android:background="@drawable/fab_tile_selector"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/fab_appswitch"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- 誤タップを避けるため切断だけ独立した行に置く -->
        <Button
            android:id="@+id/fab_disconnect"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_margin="3dp"
            android:background="@drawable/fab_tile_disconnect_selector"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/fab_disconnect"
            android:textColor="#FFFF8080"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
