<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/background_dark">

    <LinearLayout
        android:id="@+id/container1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="1">

        <SurfaceView
            android:id="@+id/decoder_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Floating menu toggle button (bottom-right) -->
    <Button
        android:id="@+id/fab_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_selector"
        android:text="@string/fab_menu_icon"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:alpha="0.6" />

    <!-- Floating control panel (hidden by default) -->
    <LinearLayout
        android:id="@+id/floating_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="68dp"
        android:background="#CC333333"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <Button
            android:id="@+id/fab_disconnect"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/fab_disconnect"
            android:textColor="#FFFF6666"
            android:textSize="13sp" />

        <Button
            android:id="@+id/fab_back"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/fab_back"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/fab_home"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/fab_home"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/fab_appswitch"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/fab_appswitch"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
